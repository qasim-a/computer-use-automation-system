  "id": "northstar_core_v1",
  "app": "northstar_core",
  "appVersion": "1.x",
  "surface": "web",
  "defaultEntrypoint": "http://127.0.0.1:4173/members",
  "policy": {
    "allowedOriginPatterns": ["^http://(127\\.0\\.0\\.1|localhost)(:\\d+)?$"],
