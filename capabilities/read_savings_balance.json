{
  "schemaVersion": "1.0",
  "capability": {
    "name": "read_savings_balance",
    "version": "1.0.0",
    "description": "Find a member and return the current savings balance",
    "target": {
      "surface": "web",
      "app": "northstar_core",
      "appVersion": "1.x",
      "entrypoint": "http://127.0.0.1:4173/members"
    }
  },
  "contract": {
    "inputs": [
      {
        "name": "member_id",
        "type": "string",
        "description": "Member number",
        "required": true,
        "sensitive": true
      }
    ],
    "outputs": [
      {
        "name": "current_balance",
        "type": "string",
        "description": "Displayed savings balance",
        "sensitive": true,
        "pattern": "^\\$[0-9,]+\\.[0-9]{2}$"
      }
    ]
  },
  "steps": [
    {
      "id": "open_members",
      "action": "navigate",
      "description": "Open member search",
      "risk": "read_only",
      "url": "${target.entrypoint}",
      "timeoutMs": 10000,
      "checkpoint": { "kind": "url", "matches": "/members(?:\\?.*)?$" }
    },
    {
      "id": "enter_member_id",
      "action": "fill",
      "description": "Enter the member number",
      "risk": "reversible",
      "value": "${inputs.member_id}",
      "timeoutMs": 10000,
      "target": {
        "key": "member_number",
        "description": "Member Number input",
        "locators": [
          { "strategy": "label", "value": "Member Number", "exact": true },
          { "strategy": "css", "value": "input[name=memberId]", "exact": true }
        ],
        "requireUnique": true
      }
    },
    {
      "id": "search_member",
      "action": "click",
      "description": "Submit member search",
      "risk": "reversible",
      "timeoutMs": 10000,
      "retry": { "maxAttempts": 2, "delayMs": 50 },
      "target": {
        "key": "search_button",
        "description": "Search button",
        "locators": [{ "strategy": "role", "role": "button", "value": "Search", "exact": true }],
        "requireUnique": true
      },
      "checkpoint": {
        "kind": "visible",
        "target": {
          "key": "member_summary",
          "description": "Member summary",
          "locators": [{ "strategy": "role", "role": "heading", "value": "Member Summary", "exact": true }],
          "requireUnique": true
        }
      }
    },
    {
      "id": "open_savings",
      "action": "click",
      "description": "Open savings account",
      "risk": "read_only",
      "timeoutMs": 10000,
      "target": {
        "key": "savings_link",
        "description": "Savings account link",
        "locators": [{ "strategy": "role", "role": "link", "value": "View Account", "exact": true }],
        "requireUnique": true
      }
    },
    {
      "id": "read_balance",
      "action": "extract",
      "description": "Read the current savings balance",
      "risk": "read_only",
      "timeoutMs": 10000,
      "output": "current_balance",
      "target": {
        "key": "current_balance",
        "description": "Current balance",
        "locators": [
          { "strategy": "css", "value": "[data-field=current-balance]", "exact": true }
        ],
        "requireUnique": true
      }
    }
  ],
  "businessOutcomes": [
    {
      "code": "member_not_found",
      "message": "No member exists for the supplied member number",
      "checkpoint": {
        "kind": "text",
        "target": {
          "key": "lookup_alert",
          "description": "Member lookup alert",
          "locators": [{ "strategy": "css", "value": "[role=alert]", "exact": true }],
          "requireUnique": true
        },
        "matches": "No member found"
      }
    }
  ],
  "success": {
    "kind": "visible",
    "target": {
      "key": "savings_table",
      "description": "Savings account table",
      "locators": [{ "strategy": "role", "role": "table", "value": "Savings account", "exact": true }],
      "requireUnique": true
    }
  },
  "metadata": {
    "createdAt": "2026-09-11T14:00:00.000Z",
    "discoveryRunId": "bootstrap-artifact"
  }
}
